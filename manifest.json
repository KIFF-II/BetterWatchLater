{
  "manifest_version": 3,
  "name": "Better Watch Later",
  "version": "0.1.2",
  "description": "One-click remove, bulk remove watched videos, and shuffle for YouTube's Watch Later playlist. Open source (GPL-3.0).",
  "homepage_url": "https://github.com/KIFF-II/BetterWatchLater",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/api.js", "src/content.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "betterwatchlater@kiff-ii",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
